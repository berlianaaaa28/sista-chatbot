# Salin file ini menjadi ".env" lalu isi API key milikmu.
# Cukup isi yang kamu punya; API yang key-nya kosong tidak akan muncul di aplikasi.

GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# (Opsional) Ganti nama model jika perlu. Jalankan "python -m providers"
# untuk melihat daftar model yang tersedia untuk key kamu.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# COHERE_MODEL=command-a-03-2025
